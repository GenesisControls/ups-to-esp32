# The Genesis Controls UPS->BMS adapter: a Waveshare ESP32-S3-RS485-CAN.
# Loaded AFTER sdkconfig.defaults AND sdkconfig.defaults.revb, and before
# sdkconfig.defaults.genesis:
#
#   idf.py -C firmware -B firmware/build-genesis-rs485 \
#       -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.revb;sdkconfig.defaults.waveshare-rs485;sdkconfig.defaults.genesis" \
#       -DUPSA_IMAGE_NAME=ups-genesis-rs485 build
#
# Layered on Rev B on purpose. The board carries an ESP32-S3R8 (8 MB octal
# PSRAM, confirmed by `esptool chip-id` and by the wiki's "default to
# ESP32-S3R8 chip") and 16 MB of external XMC flash, which is Rev B's memory
# profile on a different PCB. Taking Rev B's flash size, partition table,
# PSRAM, TLS and task settings by inheritance means a change to Rev B's
# tuning reaches this board too, rather than drifting from a second copy.
#
# NOT sdkconfig.defaults.tailscale. See sdkconfig.defaults.genesis.

CONFIG_UPSA_BOARD_WAVESHARE_RS485=y

# No display header on this board, and no I2C pins identified for the RTC.
# Kconfig would drop UPSA_HAVE_OLED anyway (UPSA_BOARD_OLED_OK is false here);
# said out loud so nobody has to work it out.
CONFIG_UPSA_HAVE_OLED=n
